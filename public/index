        function confirmVote() {
            if (appData.hasVoted) { alert('You have already voted.'); return; }
            if (!confirm('Are you sure you want to cast your vote? This cannot be undone.')) return;

            const student = appData.students.find(s => s.id === appData.currentStudentId);
            if (student) {
                student.hasVoted = true;
                const code = 'VOT-' + Math.random().toString(36).substring(2, 8).toUpperCase();
                appData.voteVerificationCodes[student.id] = code;
            }

            for (let pos in appData.userVotes) {
                const cid = appData.userVotes[pos];
                if (!appData.votes[cid]) appData.votes[cid] = 0;
                appData.votes[cid] += 1;
            }
            appData.hasVoted = true;
            
            document.getElementById('step1').className = 'voting-step completed';
            document.getElementById('step2').className = 'voting-step completed';
            document.getElementById('step3').className = 'voting-step completed';
            
            generateReceipt();
            
