        // ======================== SAVE FUNCTIONS ============================
        function saveAppearance() {
            const btn = document.getElementById('saveAppearanceBtn');
            const status = document.getElementById('appearanceSaveStatus');
            
            btn.classList.add('saving');
            btn.disabled = true;
            status.className = 'save-status';
            status.style.display = 'none';
            
            setTimeout(() => {
                try {
                    const primary = document.getElementById('primaryColor').value;
                    const accent = document.getElementById('accentColor').value;
                    const bg = document.getElementById('bgColor').value;
                    const text = document.getElementById('textColor').value;
                    const cardBg = document.getElementById('cardBg').value;
                    const headerBg = document.getElementById('headerBg').value;
                    const sidebarBg = document.getElementById('sidebarBg').value;
                    const radius = document.getElementById('borderRadius').value + 'px';
                    
                    appData.primaryColor = primary;
                    appData.accentColor = accent;
                    appData.bgColor = bg;
                    appData.textColor = text;
                    appData.cardBg = cardBg;
                    appData.headerBg = headerBg;
                    appData.sidebarBg = sidebarBg;
                    appData.borderRadius = radius;
                    
                    if (pendingFont) {
                        appData.fontFamily = pendingFont;
                        pendingFont = null;
                    }
                    
                    applyAllAppearance();
                    appData.appearanceDirty = false;
                    addActivityLog('Appearance settings updated');
                    
                    status.className = 'save-status show success';
                    status.textContent = '✅ Appearance settings saved successfully!';
                    status.style.display = 'block';
                    
                    btn.classList.remove('saving');
                    btn.disabled = false;
                    
                    setTimeout(() => {
                        status.style.display = 'none';
                    }, 4000);
                    
                } catch (error) {
                    status.className = 'save-status show error';
                    status.textContent = '❌ Error saving appearance settings. Please try again.';
                    status.style.display = 'block';
                    btn.classList.remove('saving');
                    btn.disabled = false;
                }
            }, 800);
        }

