        function exportResultsCSV() {
            let csv = 'Position,Candidate,Votes,Status\n';
            appData.positions.forEach(pos => {
                const candidates = appData.candidates.filter(c => c.position === pos);
                candidates.forEach(c => {
                    const votes = appData.votes[c.id] || 0;
                    const maxVotes = Math.max(...candidates.map(c2 => appData.votes[c2.id] || 0));
                    const isWinner = votes === maxVotes && maxVotes > 0;
                    csv += `${pos},${c.name},${votes},${isWinner ? 'WINNER' : ''}\n`;
                });
            });
            const totalStudents = appData.students.length;
            const votedCount = appData.students.filter(s => s.hasVoted).length;
            const turnout = totalStudents > 0 ? Math.round((votedCount / totalStudents) * 100) : 0;
            csv += `\nSummary\n`;
            csv += `Total Students,${totalStudents}\n`;
            csv += `Voted Students,${votedCount}\n`;
            csv += `Turnout,${turnout}%\n`;
            csv += `Total Votes,${Object.values(appData.votes).reduce((a,b) => a + b, 0)}\n`;
            csv += `Generated,${new Date().toLocaleString()}\n`;

            downloadFile(csv, 'election_results.csv', 'text/csv');
            addActivityLog('Results exported as CSV');
        }

        function exportResultsJSON() {
            const data = {
                election: {
                    title: appData.electionTitle,
                    organization: appData.orgName,
                    status: appData.electionOpen ? 'Open' : (appData.electionLocked ? 'Locked' : 'Closed'),
                    generated: new Date().toISOString()
                },
                summary: {
                    totalStudents: appData.students.length,
                    votedStudents: appData.students.filter(s => s.hasVoted).length,
                    turnout: appData.students.length > 0 ? Math.round((appData.students.filter(s => s.hasVoted).length / appData.students.length) * 100) : 0,
                    totalVotes: Object.values(appData.votes).reduce((a,b) => a + b, 0)
                },
                results: appData.positions.map(pos => {
                    const candidates = appData.candidates.filter(c => c.position === pos);
                    const maxVotes = Math.max(...candidates.map(c => appData.votes[c.id] || 0));
                    return {
                        position: pos,
                        candidates: candidates.map(c => ({
                            name: c.name,
                            platform: c.platform,
                            bio: c.bio,
                            votes: appData.votes[c.id] || 0,
                            isWinner: (appData.votes[c.id] || 0) === maxVotes && maxVotes > 0
                        }))
                    };
                }),
                candidates: appData.candidates,
                students: appData.students.map(s => ({ name: s.name, id: s.studentId, classification: s.classification, email: s.email, hasVoted: s.hasVoted }))
            };

            const json = JSON.stringify(data, null, 2);
            downloadFile(json, 'election_results.json', 'application/json');
            addActivityLog('Results exported as JSON');
        }

