            font-weight: 600;
            font-size: 13px;
            color: var(--primary-color);
            display: block;
            margin-bottom: 4px;
        }

        .modal-content .input-group input {
            width: 100%;
            padding: 12px 14px;
            border: 2px solid #d0dce8;
            border-radius: 10px;
            font-size: 14px;
            outline: none;
            transition: 0.3s;
            background: #f8faff;
            color: var(--primary-color);
        }

        .modal-content .input-group input:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(18, 60, 105, 0.08);
        }

        .modal-content .password-hint {
