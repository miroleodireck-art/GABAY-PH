        function bulkImportStudents() {
            const fileInput = document.getElementById('csvFileInput');
            const file = fileInput.files[0];
            if (!file) {
                alert('Please select a CSV file first.');
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const text = e.target.result;
                    const lines = text.split('\n').filter(line => line.trim());
                    let imported = 0;
                    let errors = [];

                    lines.forEach((line, index) => {
                        if (index === 0 && line.toLowerCase().includes('name')) return;

                        const parts = line.split(',').map(p => p.trim());
                        if (parts.length < 5) {
                            errors.push(`Line ${index + 1}: Invalid format (need at least 5 columns)`);
                            return;
                        }

                        const [name, studentId, classification, username, password, email] = parts;

                        if (!name || !studentId || !username || !password) {
                            errors.push(`Line ${index + 1}: Missing required fields`);
                            return;
                        }

                        if (appData.students.some(s => s.username === username)) {
                            errors.push(`Line ${index + 1}: Username '${username}' already exists`);
                            return;
                        }
                        if (appData.students.some(s => s.studentId === studentId)) {
                            errors.push(`Line ${index + 1}: Student ID '${studentId}' already exists`);
                            return;
                        }

                        appData.students.push({
                            id: appData.nextStudentId++,
                            name,
                            studentId,
                            classification: classification || 'Grade 12',
                            username: username,
                            password: password || 'student123',
                            email: email || `${username}@example.com`,
                            hasVoted: false
                        });
                        imported++;
                    });

                    renderStudentListAdmin();
                    updateUI();
                    addActivityLog(`Bulk imported ${imported} students`);
                    alert(`✅ ${imported} students imported successfully!\n${errors.length > 0 ? '\nErrors:\n' + errors.join('\n') : ''}`);
                    fileInput.value = '';
                } catch (error) {
                    alert('Error parsing CSV file: ' + error.message);
                }
            };
            reader.readAsText(file);
        }

