<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GABAY PH · Election Portal</title>
    <meta name="theme-color" content="#123c69">
    <link rel="manifest" href="data:application/json;base64,">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <style>
        :root {
            --primary-color: #123c69;
            --accent-color: #f5c842;
            --bg-color: #f0f4fa;
            --text-color: #1e2b3c;
            --card-bg: #ffffff;
            --header-bg: #ffffff;
            --sidebar-bg: #0a2a4a;
            --login-bg-start: #0a2a4a;
            --login-bg-end: #2a6a96;
            --border-radius: 12px;
            --font-family: 'Segoe UI', Roboto, Arial, sans-serif;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
            --transition: 0.3s ease;
            --login-bg-image: none;
            --main-bg-image: none;
            --sidebar-bg-image: none;
            --save-success: #1d7a3e;
            --save-error: #c0392b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: var(--bg-color);
            color: var(--text-color);
            display: flex;
            min-height: 100vh;
            transition: background var(--transition), color var(--transition);
            font-family: var(--font-family);
            background-image: var(--main-bg-image);
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: var(--bg-color);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--primary-color);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent-color);
        }

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: var(--sidebar-bg);
            color: white;
            padding: 20px 16px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            z-index: 1000;
            box-shadow: 2px 0 20px rgba(0,0,0,0.3);
            overflow-y: auto;
            transition: background var(--transition), color var(--transition);
            background-image: var(--sidebar-bg-image);
            background-size: cover;
            background-position: center;
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 8px 16px 8px;
            border-bottom: 2px solid rgba(245, 200, 66, 0.3);
            margin-bottom: 8px;
            flex-shrink: 0;
        }

        .sidebar-brand img {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--accent-color);
            transition: border-color var(--transition);
            flex-shrink: 0;
        }

        .sidebar-brand span {
            font-weight: 700;
            font-size: 20px;
            color: white;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .sidebar .btn {
            width: 100%;
            padding: 12px 16px;
            border: none;
            border-radius: 10px;
            background: transparent;
            color: rgba(255,255,255,0.85);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.25s;
            text-align: left;
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .sidebar .btn:hover {
            background: rgba(255,255,255,0.12);
            color: white;
            transform: translateX(4px);
        }

        .sidebar .btn.active-nav {
            background: rgba(245, 200, 66, 0.2);
            color: var(--accent-color);
            border-left: 3px solid var(--accent-color);
            border-radius: 10px 0 0 10px;
        }

        .sidebar .btn .icon {
            font-size: 18px;
            width: 28px;
            text-align: center;
            flex-shrink: 0;
        }

        .sidebar .btn .btn-label {
            white-space: nowrap;
        }

        .sidebar .shortcut-hint {
            font-size: 10px;
            color: rgba(255,255,255,0.3);
            margin-left: auto;
            padding: 2px 8px;
            background: rgba(255,255,255,0.05);
            border-radius: 4px;
        }

        .sidebar .user-info {
            margin-top: auto;
            padding-top: 16px;
            border-top: 1px solid rgba(255,255,255,0.1);
            font-size: 13px;
            color: rgba(255,255,255,0.7);
            flex-shrink: 0;
        }

        .sidebar .user-info .user-name {
            font-weight: 600;
            color: white;
            margin-bottom: 4px;
            font-size: 14px;
        }

        .sidebar .user-info .badge {
            background: var(--accent-color);
            color: var(--sidebar-bg);
            padding: 2px 14px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 11px;
            display: inline-block;
            transition: background var(--transition), color var(--transition);
        }

        .sidebar .user-info .badge-admin {
            background: var(--accent-color);
            color: var(--sidebar-bg);
        }

        .sidebar .user-info .logout-btn {
            background: rgba(255,70,70,0.15);
            color: #ff6b6b;
            border: none;
            padding: 8px 14px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            transition: 0.2s;
            margin-top: 8px;
            width: 100%;
            text-align: center;
        }

        .sidebar .user-info .logout-btn:hover {
            background: rgba(255,70,70,0.25);
        }

        .sidebar .user-info .live-time {
            font-size: 12px;
            color: rgba(255,255,255,0.6);
            text-align: center;
            margin-top: 8px;
            font-family: monospace;
            letter-spacing: 0.5px;
            border-top: 1px solid rgba(255,255,255,0.05);
            padding-top: 8px;
        }

        .sidebar .user-info .live-time .time-label {
            font-size: 10px;
            text-transform: uppercase;
            opacity: 0.6;
            display: block;
            margin-bottom: 2px;
        }

        .sidebar .user-info .session-timer {
            font-size: 11px;
            color: rgba(255,255,255,0.4);
            text-align: center;
            margin-top: 4px;
            font-family: monospace;
        }

        .main-content {
            margin-left: 250px;
            flex: 1;
            min-height: 100vh;
            padding: 24px;
            background: var(--bg-color);
            transition: background var(--transition);
            background-image: var(--main-bg-image);
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        .page {
            display: none;
            animation: fade 0.3s ease;
        }

        .page.active {
            display: block;
        }

        @keyframes fade {
            0% { opacity: 0.4; transform: translateY(8px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .container {
            max-width: 1440px;
            margin: 0 auto;
        }

        .live-time-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0 16px 0;
            flex-wrap: wrap;
            gap: 10px;
        }

        .live-time-header .time-display {
            font-size: 16px;
            font-weight: 600;
            color: var(--primary-color);
            font-family: monospace;
            letter-spacing: 0.5px;
            background: rgba(255,255,255,0.9);
            padding: 8px 20px;
            border-radius: 30px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .live-time-header .time-display .time-icon {
            font-size: 18px;
        }

        .live-time-header .time-display .live-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            background: #e74c3c;
            border-radius: 50%;
            animation: pulse-dot 1.5s infinite;
            margin-right: 4px;
        }

        @keyframes pulse-dot {
            0% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(0.8); }
            100% { opacity: 1; transform: scale(1); }
        }

        .live-time-header .system-status {
            font-size: 13px;
            color: #4a6a8a;
            background: rgba(255,255,255,0.9);
            padding: 8px 18px;
            border-radius: 30px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .live-time-header .system-status .status-badge {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }

        .live-time-header .system-status .status-badge.online {
            background: #1d7a3e;
        }

        .live-time-header .system-status .status-badge.offline {
            background: #c0392b;
        }

        #loginPage {
            display: none;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9999;
            margin: 0;
            background: linear-gradient(135deg, var(--login-bg-start) 0%, var(--primary-color) 40%, var(--login-bg-end) 70%, #2a6a96 100%);
            transition: background 0.8s ease;
            background-image: var(--login-bg-image);
            background-size: cover;
            background-position: center;
        }

        #loginPage::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 30% 50%, rgba(245, 200, 66, 0.06) 0%, transparent 60%);
            animation: rotateGlow 20s linear infinite;
            pointer-events: none;
        }

        @keyframes rotateGlow {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        #loginPage.active {
            display: flex !important;
        }

        .login-box {
            width: 100%;
            max-width: 480px;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(12px);
            padding: 44px 36px;
            border-radius: 40px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
            text-align: center;
            position: relative;
            z-index: 1;
            border: 1px solid rgba(245, 200, 66, 0.2);
        }

        .login-box .logo {
            width: 120px;
            height: 120px;
            object-fit: cover;
            border-radius: 50%;
            margin-bottom: 12px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2), 0 0 0 3px rgba(245, 200, 66, 0.3);
            border: 3px solid var(--accent-color);
            transition: border-color var(--transition);
        }

        .login-box h1 {
            color: var(--primary-color);
            font-size: 36px;
            letter-spacing: -0.5px;
            font-weight: 700;
            transition: color var(--transition);
        }

        .login-box h2 {
            color: #2a6a96;
            font-weight: 500;
            font-size: 18px;
            margin-bottom: 4px;
        }

        .login-box .subtitle {
            color: #4a6a8a;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .login-box .login-time {
            font-size: 13px;
            color: #4a6a8a;
            margin-bottom: 16px;
            background: rgba(18, 60, 105, 0.05);
            padding: 6px 12px;
            border-radius: 20px;
            display: inline-block;
        }

        .role-selector {
            display: flex;
            gap: 12px;
            justify-content: center;
            margin: 16px 0 20px;
            flex-wrap: wrap;
        }

        .role-selector label {
            background: #e8eef5;
            padding: 10px 24px;
            border-radius: 40px;
            font-weight: 500;
            cursor: pointer;
            border: 2px solid transparent;
            transition: 0.3s;
            font-size: 15px;
            color: var(--primary-color);
            flex: 1;
            min-width: 100px;
        }

        .role-selector label:hover {
            background: #d5e2f0;
            transform: translateY(-2px);
        }

        .role-selector label:has(input:checked) {
            background: var(--primary-color);
            border-color: var(--accent-color);
            color: white;
        }

        .role-selector input[type="radio"] {
            display: none;
        }

        .input-group {
            text-align: left;
            margin: 14px 0 6px;
        }

        .input-group label {
            font-weight: 600;
            font-size: 13px;
            color: var(--primary-color);
            display: block;
            margin-bottom: 4px;
            transition: color var(--transition);
        }

        .input-group input,
        .input-group textarea,
        .input-group select {
            width: 100%;
            padding: 14px 16px;
            border: 2px solid #d0dce8;
            border-radius: 14px;
            font-size: 15px;
            background: #f8faff;
            transition: 0.3s;
            outline: none;
            color: var(--primary-color);
            font-family: inherit;
        }

        .input-group input:focus,
        .input-group textarea:focus,
        .input-group select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 4px rgba(18, 60, 105, 0.12);
        }

        .login-error {
            color: #c0392b;
            font-size: 14px;
            min-height: 26px;
            margin-top: 6px;
        }

        .login-btn {
            padding: 14px 28px;
            border: none;
            border-radius: 40px;
            background: linear-gradient(135deg, var(--primary-color), #0a2a4a);
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.3s;
            width: 100%;
        }

        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(18, 60, 105, 0.4);
        }

        .login-box .demo-hint {
            margin-top: 16px;
            font-size: 13px;
            color: #4a6a8a;
            background: rgba(18, 60, 105, 0.06);
            padding: 8px 16px;
            border-radius: 30px;
            display: inline-block;
        }

        .login-box .forgot-password {
            margin-top: 12px;
            font-size: 13px;
        }

        .login-box .forgot-password a {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 500;
            cursor: pointer;
        }

        .login-box .forgot-password a:hover {
            text-decoration: underline;
            color: var(--accent-color);
        }

        .tutorial-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: fade 0.5s ease;
        }

        .tutorial-modal {
            background: white;
            border-radius: var(--border-radius);
            max-width: 600px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 30px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.5);
            position: relative;
        }

        .tutorial-modal .tutorial-close {
            position: absolute;
            top: 15px;
            right: 20px;
            background: none;
            border: none;
            font-size: 28px;
            cursor: pointer;
            color: #4a6a8a;
            transition: 0.3s;
        }

        .tutorial-modal .tutorial-close:hover {
            color: #c0392b;
            transform: rotate(90deg);
        }

        .tutorial-modal h2 {
            color: var(--primary-color);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tutorial-modal .tutorial-step {
            display: none;
            animation: fade 0.5s ease;
        }

        .tutorial-modal .tutorial-step.active {
            display: block;
        }

        .tutorial-modal .tutorial-step .step-number {
            display: inline-block;
            background: var(--accent-color);
            color: var(--primary-color);
            width: 30px;
            height: 30px;
            border-radius: 50%;
            text-align: center;
            line-height: 30px;
            font-weight: 700;
            margin-right: 10px;
        }

        .tutorial-modal .tutorial-step .step-title {
            font-size: 20px;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 12px;
        }

        .tutorial-modal .tutorial-step .step-content {
            color: #4a6a8a;
            line-height: 1.8;
            margin-bottom: 16px;
        }

        .tutorial-modal .tutorial-step .step-content ul {
            padding-left: 20px;
            margin: 8px 0;
        }

        .tutorial-modal .tutorial-step .step-content ul li {
            margin-bottom: 6px;
        }

        .tutorial-modal .tutorial-step .step-image {
            background: #f8faff;
            padding: 16px;
            border-radius: var(--border-radius);
            text-align: center;
            margin: 12px 0;
            border: 1px solid #e2eaf3;
        }

        .tutorial-modal .tutorial-step .step-image .icon-large {
            font-size: 64px;
            display: block;
            margin-bottom: 8px;
        }

        .tutorial-modal .tutorial-step .step-image .image-label {
            font-size: 13px;
            color: #4a6a8a;
        }

        .tutorial-modal .tutorial-progress {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin: 16px 0;
        }

        .tutorial-modal .tutorial-progress .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #d0dce8;
            transition: 0.3s;
            cursor: pointer;
        }

        .tutorial-modal .tutorial-progress .dot.active {
            background: var(--primary-color);
            transform: scale(1.2);
        }

        .tutorial-modal .tutorial-progress .dot.completed {
            background: #1d7a3e;
        }

        .tutorial-modal .tutorial-nav {
            display: flex;
            gap: 12px;
            margin-top: 16px;
            justify-content: space-between;
        }

        .tutorial-modal .tutorial-nav .btn {
            width: auto;
            padding: 10px 24px;
            min-width: 100px;
        }

        .tutorial-modal .tutorial-nav .btn-outline {
            background: transparent;
            border: 2px solid var(--primary-color);
            color: var(--primary-color);
        }

        .tutorial-modal .tutorial-nav .btn-outline:hover {
            background: var(--primary-color);
            color: white;
        }

        .tutorial-modal .tutorial-nav .btn-success {
            background: #1d7a3e;
        }

        .tutorial-modal .tutorial-nav .btn-success:hover {
            background: #156a2e;
        }

        .tutorial-modal .tutorial-nav .btn-secondary {
            background: #6f7f92;
        }

        .tutorial-modal .tutorial-nav .btn-secondary:hover {
            background: #4a6a8a;
        }

        .tutorial-tooltip {
            position: fixed;
            background: var(--primary-color);
            color: white;
            padding: 12px 18px;
            border-radius: 8px;
            font-size: 13px;
            max-width: 300px;
            z-index: 9998;
            box-shadow: 0 8px 30px rgba(0,0,0,0.3);
            animation: fade 0.3s ease;
            pointer-events: none;
        }

        .tutorial-tooltip::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 20px;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-top: 8px solid var(--primary-color);
        }

        .header {
            background: var(--header-bg);
            color: var(--primary-color);
            text-align: center;
            padding: 24px 28px;
            border-radius: var(--border-radius);
            margin-bottom: 24px;
            box-shadow: var(--shadow);
            border-bottom: 3px solid var(--accent-color);
            transition: background var(--transition), color var(--transition), border-color var(--transition), border-radius var(--transition), box-shadow var(--transition);
        }

        .header h1 {
            font-size: 30px;
            letter-spacing: -0.3px;
            color: var(--primary-color);
            transition: color var(--transition);
        }

        .header p {
            color: #4a6a8a;
            margin-top: 4px;
        }

        .dashboard-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 24px;
        }

        .dashboard-grid .full-width {
            grid-column: 1 / -1;
        }

        .card {
            background: var(--card-bg);
            padding: 24px 28px;
            border-radius: var(--border-radius);
            margin-bottom: 0;
            box-shadow: var(--shadow);
            border-left: 4px solid var(--primary-color);
            transition: background var(--transition), border-color var(--transition), border-radius var(--transition), box-shadow var(--transition);
        }

        .card h2 {
            color: var(--primary-color);
            margin-bottom: 14px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 19px;
            transition: color var(--transition);
        }

        .card p {
            line-height: 1.7;
            margin-bottom: 4px;
        }

        .user-card {
            background: #f8faff;
            padding: 24px 28px;
            border-radius: var(--border-radius);
            margin-bottom: 0;
            box-shadow: var(--shadow);
            border: 1px solid rgba(18, 60, 105, 0.08);
            transition: background var(--transition), border-color var(--transition), border-radius var(--transition);
        }

        .user-card h2 {
            color: var(--primary-color);
            transition: color var(--transition);
            font-size: 22px;
        }

        .badge {
            background: var(--primary-color);
            padding: 4px 18px;
            border-radius: 40px;
            font-weight: 600;
            color: white;
            display: inline-block;
            transition: background var(--transition), color var(--transition);
        }

        .badge-admin {
            background: var(--accent-color);
            color: var(--primary-color);
        }

        .badge-voted {
            background: #1d7a3e;
            padding: 2px 14px;
            border-radius: 30px;
            font-weight: 600;
            color: white;
            font-size: 12px;
            display: inline-block;
        }

        .badge-not-voted {
            background: #c0392b;
            padding: 2px 14px;
            border-radius: 30px;
            font-weight: 600;
            color: white;
            font-size: 12px;
            display: inline-block;
        }

        .badge-winner {
            background: #f39c12;
            padding: 2px 14px;
            border-radius: 30px;
            font-weight: 700;
            color: white;
            font-size: 12px;
            display: inline-block;
            animation: pulse-gold 2s infinite;
        }

        @keyframes pulse-gold {
