                        showShortcutHint();
                        addActivityLog('Admin logged in');
                        return;
                    }
                }
                errorEl.textContent = '❌ Invalid admin credentials.';
                return;
            }

            if (role === 'user') {
                const student = appData.students.find(s => s.username === username && s.password === password);
                if (student) {
                    appData.currentUser = student.name;
                    appData.currentRole = 'user';
