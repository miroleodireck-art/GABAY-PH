            if (statusBadge) {
                if (appData.electionLocked) {
                    statusBadge.textContent = '🔒 Locked';
                    statusBadge.style.color = '#f39c12';
                } else if (appData.electionOpen) {
                    statusBadge.textContent = '● Open';
                    statusBadge.style.color = '#1d7a3e';
                } else {
                    statusBadge.textContent = '● Closed';
                    statusBadge.style.color = '#c0392b';
                }
