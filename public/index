        function deletePosition(pos) {
            if (!confirm(`Delete position "${pos}" and all its candidates?`)) return;
            appData.positions = appData.positions.filter(p => p !== pos);
            appData.candidates = appData.candidates.filter(c => c.position !== pos);
            renderPositionListAdmin();
            populatePositionSelect();
            renderCandidateListAdmin();
