        // ======================== STUDENT FILTER ============================
        function filterStudents() {
            const search = document.getElementById('studentSearch').value.toLowerCase();
            renderStudentListAdmin(search);
        }

        function renderStudentListAdmin(search = '') {
            const container = document.getElementById('studentListAdmin');
            const filtered = appData.students.filter(s => 
                s.name.toLowerCase().includes(search) || 
                s.studentId.toLowerCase().includes(search) || 
                s.username.toLowerCase().includes(search)
            );

            if (filtered.length === 0) {
                container.innerHTML = '<p style="color:#4a6a8a;padding:10px;">No students found.</p>';
                return;
            }

            const classifications = [
                'Grade 7', 'Grade 8', 'Grade 9', 'Grade 10', 'Grade 11', 'Grade 12',
                'College - 1st Year', 'College - 2nd Year', 'College - 3rd Year', 'College - 4th Year', 'College - 5th Year'
            ];
            
            let html = '';
            classifications.forEach(classif => {
                const students = filtered.filter(s => s.classification === classif);
                if (students.length === 0) return;
                
                html += `<div class="year-group">
                    <h3>${classif} <span class="count">(${students.length} students)</span></h3>`;
                students.forEach(s => {
                    const status = s.hasVoted ? 
                        '<span class="badge-voted">✅ Voted</span>' : 
                        '<span class="badge-not-voted">⏳ Not Voted</span>';
                    html += `
                        <div class="student-card">
                            <div class="student-info">
                                <strong>${s.name}</strong>
                                <span>ID: ${s.studentId}</span>
                                <span>Username: ${s.username}</span>
                                <span style="color:#4a6a8a;font-size:12px;">📧 ${s.email || 'No email'}</span>
                                ${status}
                            </div>
                            <div>
                                <span class="${classif.includes('College') ? 'badge-college' : 'badge-year'}" style="background:var(--primary-color);color:white;padding:2px 12px;border-radius:20px;font-size:11px;">${s.classification}</span>
                                <button class="delete-btn delete-btn-sm" onclick="deleteStudent(${s.id})">Remove</button>
                            </div>
                        </div>
                    `;
                });
                html += `</div>`;
            });
            container.innerHTML = html;
        }

        // ======================== CANDIDATE FILTER ============================
        function filterCandidates() {
            const search = document.getElementById('candidateSearch').value.toLowerCase();
            renderCandidateListAdmin(search);
        }

        function renderCandidateListAdmin(search = '') {
            const container = document.getElementById('candidateListAdmin');
            const filtered = appData.candidates.filter(c => 
                c.name.toLowerCase().includes(search) || 
                c.position.toLowerCase().includes(search)
            );

            if (filtered.length === 0) {
                container.innerHTML = '<p style="color:#4a6a8a;padding:10px;">No candidates found.</p>';
                return;
            }

            let html = '<div style="overflow-x:auto;"><table class="admin-table"><thead><tr><th>Name</th><th>Position</th><th>Platform</th><th>Votes</th><th>Action</th></tr></thead><tbody>';
            filtered.forEach(c => {
                const votes = appData.votes[c.id] || 0;
                const positionCandidates = appData.candidates.filter(c2 => c2.position === c.position);
                const maxVotes = Math.max(...positionCandidates.map(c2 => appData.votes[c2.id] || 0));
                const isWinner = votes === maxVotes && maxVotes > 0;
                html += `<tr>
                    <td><strong>${c.name}</strong> ${isWinner ? '🏆' : ''}</td>
                    <td><span class="position-badge">${c.position}</span></td>
                    <td>${c.platform || ''}</td>
                    <td>${votes}</td>
                    <td><button class="delete-btn delete-btn-sm" onclick="deleteCandidate(${c.id})">Delete</button></td>
                </tr>`;
            });
            html += '</tbody></table></div>';
            container.innerHTML = html;
        }

