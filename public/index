        function restoreBackup() {
            const fileInput = document.getElementById('restoreFileInput');
            const file = fileInput.files[0];
            if (!file) {
                alert('Please select a backup file first.');
                return;
            }

            if (!confirm('⚠️ Restoring will overwrite all current data. Are you sure?')) return;
            if (!confirm('⚠️ Final confirmation: This action is irreversible.')) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const backup = JSON.parse(e.target.result);
                    if (!backup.data || !backup.version) {
                        alert('Invalid backup file format.');
                        return;
                    }

                    const d = backup.data;
                    appData.students = d.students || [];
                    appData.candidates = d.candidates || [];
                    appData.votes = d.votes || {};
                    appData.announcements = d.announcements || [];
                    appData.positions = d.positions || [];
                    appData.electionTitle = d.electionTitle || 'National Election 2026';
                    appData.electionOpen = d.electionOpen !== undefined ? d.electionOpen : true;
                    appData.electionLocked = d.electionLocked || false;
                    appData.electionStart = d.electionStart || null;
                    appData.electionEnd = d.electionEnd || null;
                    appData.autoLock = d.autoLock || false;
                    appData.orgName = d.orgName || 'GABAY PH';
                    appData.sessionTimeoutMinutes = d.sessionTimeoutMinutes || 30;
                    
                    if (d.primaryColor) appData.primaryColor = d.primaryColor;
                    if (d.accentColor) appData.accentColor = d.accentColor;
                    if (d.bgColor) appData.bgColor = d.bgColor;
                    if (d.textColor) appData.textColor = d.textColor;
                    if (d.cardBg) appData.cardBg = d.cardBg;
                    if (d.headerBg) appData.headerBg = d.headerBg;
                    if (d.sidebarBg) appData.sidebarBg = d.sidebarBg;
                    if (d.loginBgStart) appData.loginBgStart = d.loginBgStart;
                    if (d.loginBgEnd) appData.loginBgEnd = d.loginBgEnd;
                    if (d.borderRadius) appData.borderRadius = d.borderRadius;
                    if (d.fontFamily) appData.fontFamily = d.fontFamily;
                    if (d.logoUrl) appData.logoUrl = d.logoUrl;
                    if (d.loginBgImage) appData.loginBgImage = d.loginBgImage;
                    if (d.mainBgImage) appData.mainBgImage = d.mainBgImage;
                    if (d.sidebarBgImage) appData.sidebarBgImage = d.sidebarBgImage;

                    appData.nextStudentId = Math.max(1, ...appData.students.map(s => s.id || 0)) + 1;
                    appData.nextCandidateId = Math.max(1, ...appData.candidates.map(c => c.id || 0)) + 1;
                    appData.nextAnnouncementId = Math.max(1, ...appData.announcements.map(a => a.id || 0)) + 1;

                    appData.userVotes = {};
                    appData.hasVoted = false;
                    appData.currentUser = null;
                    appData.currentRole = null;
                    appData.currentStudentId = null;

                    applyAllAppearance();
                    renderCandidateListAdmin();
                    renderPositionListAdmin();
                    renderStudentListAdmin();
                    populatePositionSelect();
                    updateUI();
                    
                    addActivityLog('Data restored from backup');
                    alert('✅ Data restored successfully! Please login again.');
                    
                    logout();
                    
                } catch (error) {
                    alert('Error restoring backup: ' + error.message);
                }
            };
            reader.readAsText(file);
        }

        // ======================== VOTE RECOUNT ============================
        function recountVotes() {
            if (appData.currentRole !== 'admin') {
                alert('Admin access required.');
                return;
            }

            if (!confirm('🔢 Perform a vote recount? This will recalculate all votes and verify integrity.')) return;

            let totalVotes = Object.values(appData.votes).reduce((a, b) => a + b, 0);
            let studentsVoted = appData.students.filter(s => s.hasVoted).length;
            let issues = [];

            if (totalVotes !== studentsVoted) {
                issues.push(`⚠️ Vote count mismatch: ${totalVotes} votes recorded, ${studentsVoted} students voted.`);
            }

            appData.candidates.forEach(c => {
                const votes = appData.votes[c.id] || 0;
                if (votes > appData.students.length) {
                    issues.push(`⚠️ Candidate ${c.name} has ${votes} votes, exceeding total students (${appData.students.length}).`);
                }
            });

            if (issues.length === 0 && totalVotes === studentsVoted) {
                alert(`✅ Vote recount completed successfully!\n\n📊 Results:\n• Total Votes: ${totalVotes}\n• Students Voted: ${studentsVoted}\n• Turnout: ${appData.students.length > 0 ? Math.round((studentsVoted/appData.students.length)*100) : 0}%\n• All votes verified. No issues found.`);
                addActivityLog('Vote recount completed - No issues found');
            } else if (issues.length > 0) {
                alert(`⚠️ Vote recount found issues:\n\n${issues.join('\n')}\n\nPlease investigate these issues manually.`);
                addActivityLog('Vote recount completed - Issues found: ' + issues.join('; '));
            } else {
                alert(`✅ Vote recount completed.\n\n📊 Results:\n• Total Votes: ${totalVotes}\n• Students Voted: ${studentsVoted}\n• All votes are consistent.`);
                addActivityLog('Vote recount completed - All consistent');
            }

            updateUI();
        }

