        async function exportResultsPDF() {
            try {
                const btn = document.querySelector('[onclick="exportResultsPDF()"]');
                if (btn) {
                    btn.textContent = '⏳ Generating PDF...';
                    btn.disabled = true;
                }

                const resultsElement = document.getElementById('tabResults');
                if (!resultsElement) {
                    alert('Results not found.');
                    return;
                }

                resultsElement.style.display = 'block';
                await new Promise(resolve => setTimeout(resolve, 500));

                const canvas = await html2canvas(resultsElement, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: '#ffffff'
                });

                const imgData = canvas.toDataURL('image/png');

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF('p', 'mm', 'a4');
                const pdfWidth = pdf.internal.pageSize.getWidth();
                const pdfHeight = (canvas.height * pdfWidth) / canvas.width;

                pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
                pdf.save('election_results.pdf');
                
                addActivityLog('Results exported as PDF');
                
                if (btn) {
                    btn.textContent = '📄 Export PDF';
                    btn.disabled = false;
                }
            } catch (error) {
                console.error('PDF export error:', error);
                alert('Error generating PDF. Please try again or use the print function instead.');
                const btn = document.querySelector('[onclick="exportResultsPDF()"]');
                if (btn) {
                    btn.textContent = '📄 Export PDF';
                    btn.disabled = false;
                }
            }
        }

        function downloadFile(content, filename, mimeType) {
            const blob = new Blob([content], { type: mimeType });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        // ======================== ADMIN: RESULTS & CHARTS ============================
        function renderResults() {
            const container = document.getElementById('resultsContainer');
            let html = '';
            appData.positions.forEach(pos => {
                const candidates = appData.candidates.filter(c => c.position === pos);
                if (candidates.length === 0) {
                    html += `<div class="card"><h3>${pos}</h3><p style="color:#4a6a8a;">No candidates.</p></div>`;
                    return;
                }
                let total = 0;
                candidates.forEach(c => { total += (appData.votes[c.id] || 0); });
                const maxVotes = Math.max(...candidates.map(c => appData.votes[c.id] || 0));
                html += `<div class="card"><h3>${pos}</h3><div class="chart-container">`;
                candidates.forEach(c => {
                    const votes = appData.votes[c.id] || 0;
                    const pct = total > 0 ? Math.round((votes / total) * 100) : 0;
                    const isWinner = votes === maxVotes && maxVotes > 0;
                    html += `
                        <div class="chart-bar-wrapper" style="margin-bottom:8px;">
                            <div class="chart-bar-label" style="display:flex;justify-content:space-between;font-size:13px;">
                                <span>${c.name} ${isWinner ? '👑' : ''}</span>
                                <span>${votes} votes (${pct}%)</span>
                            </div>
                            <div class="chart-bar-track" style="background:#eef3f9;border-radius:4px;height:20px;overflow:hidden;">
                                <div class="chart-bar-fill ${isWinner ? 'winner' : ''}" style="width:${pct}%;background:${isWinner ? '#f39c12' : appData.primaryColor};height:100%;display:flex;align-items:center;justify-content:center;color:white;font-size:11px;font-weight:600;transition:width 0.5s ease;">${pct}%</div>
                            </div>
                        </div>
                    `;
                });
                html += `</div></div>`;
            });
            container.innerHTML = html;
            
            setTimeout(() => renderCharts(), 100);
        }

        function renderCharts() {
            const candidatesWithVotes = appData.candidates.filter(c => (appData.votes[c.id] || 0) > 0);
            const labels = candidatesWithVotes.map(c => c.name.length > 15 ? c.name.substring(0, 12) + '...' : c.name);
            const data = candidatesWithVotes.map(c => appData.votes[c.id] || 0);
            const colors = [appData.primaryColor, '#2a6a96', appData.accentColor, '#e67e22', '#1d7a3e', '#c0392b', '#6f7f92', '#4a6a8a'];
            
            const barCtx = document.getElementById('barChart');
            if (barCtx) {
                if (chartInstances.bar) chartInstances.bar.destroy();
                chartInstances.bar = new Chart(barCtx, {
                    type: 'bar',
                    data: {
                        labels: labels.length > 0 ? labels : ['No votes yet'],
                        datasets: [{
                            label: 'Votes',
                            data: data.length > 0 ? data : [0],
                            backgroundColor: colors.slice(0, data.length || 1),
                            borderColor: '#0a2a4a',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: { display: false },
                            title: { display: true, text: 'Vote Distribution' }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { stepSize: 1 }
                            }
                        }
                    }
                });
            }

            const pieCtx = document.getElementById('pieChart');
            if (pieCtx) {
                if (chartInstances.pie) chartInstances.pie.destroy();
                chartInstances.pie = new Chart(pieCtx, {
                    type: 'pie',
                    data: {
                        labels: labels.length > 0 ? labels : ['No votes'],
                        datasets: [{
                            data: data.length > 0 ? data : [1],
                            backgroundColor: colors.slice(0, data.length || 1),
                            borderColor: 'white',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { font: { size: 11 } }
                            },
                            title: { display: true, text: 'Vote Share' }
                        }
                    }
                });
            }

            const turnoverCtx = document.getElementById('turnoverChart');
            if (turnoverCtx) {
                if (chartInstances.turnover) chartInstances.turnover.destroy();
                const total = appData.students.length;
                const voted = appData.students.filter(s => s.hasVoted).length;
                const notVoted = total - voted;
                chartInstances.turnover = new Chart(turnoverCtx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Voted', 'Not Voted'],
                        datasets: [{
                            data: [voted, notVoted],
                            backgroundColor: ['#1d7a3e', '#c0392b'],
                            borderColor: 'white',
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: true,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { font: { size: 11 } }
                            },
                            title: { display: true, text: `Turnout: ${total > 0 ? Math.round((voted/total)*100) : 0}%` }
                        }
                    }
                });
            }

            const winnersContainer = document.getElementById('winnersList');
            if (winnersContainer) {
                let winnersHtml = '';
                appData.positions.forEach(pos => {
                    const candidates = appData.candidates.filter(c => c.position === pos);
                    if (candidates.length === 0) return;
                    const maxVotes = Math.max(...candidates.map(c => appData.votes[c.id] || 0));
                    const winners = candidates.filter(c => (appData.votes[c.id] || 0) === maxVotes && maxVotes > 0);
                    winners.forEach(w => {
                        winnersHtml += `
                            <div style="display:flex;justify-content:space-between;padding:8px 12px;border-bottom:1px solid #eef3f9;align-items:center;">
                                <div>
                                    <span class="winner-crown">👑</span>
                                    <strong>${w.name}</strong>
                                    <span style="color:#4a6a8a;font-size:12px;"> (${pos})</span>
                                </div>
                                <div>
                                    <span class="badge-winner">🏆 WINNER</span>
                                    <span style="color:#4a6a8a;font-size:12px;margin-left:8px;">${appData.votes[w.id] || 0} votes</span>
                                </div>
                            </div>
                        `;
                    });
                });
                if (winnersHtml) {
                    winnersContainer.innerHTML = winnersHtml;
                } else {
                    winnersContainer.innerHTML = '<p style="color:#4a6a8a;">No winners declared yet.</p>';
                }
            }
            
            updateLiveTime();
        }

