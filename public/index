            const voterBadge = document.getElementById('voterStatusBadge');
            if (voterBadge && isVoter) {
                const student = appData.students.find(s => s.id === appData.currentStudentId);
                if (student && student.hasVoted) {
                    voterBadge.innerHTML = '<span class="badge-voted">✅ You have voted</span>';
