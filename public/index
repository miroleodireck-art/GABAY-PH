                    voterBadge.innerHTML = '<span class="badge-not-voted">⏳ You have not voted yet</span>';
                }
            }

            updateDashboard();
            updateVoterDashboard();
        }

        // ======================== VOTER DASHBOARD ============================
        function updateVoterDashboard() {
            if (appData.currentRole !== 'user') return;

            const student = appData.students.find(s => s.id === appData.currentStudentId);
            document.getElementById('voterDashName').textContent = appData.currentUser || 'User';

            const statusDiv = document.getElementById('voterDashStatus');
            if (student && student.hasVoted) {
                statusDiv.innerHTML = `
                    <span class="badge-voted" style="font-size:16px;padding:6px 20px;">✅ You have successfully voted!</span>
                    <p style="margin-top:8px;color:#4a6a8a;">Thank you for participating in the election.</p>
                `;
            } else if (appData.electionLocked) {
                statusDiv.innerHTML = `
                    <span class="badge-not-voted" style="font-size:16px;padding:6px 20px;">🔒 Voting is locked</span>
                    <p style="margin-top:8px;color:#4a6a8a;">The election has been finalized.</p>
                `;
            } else if (!appData.electionOpen) {
                statusDiv.innerHTML = `
                    <span class="badge-not-voted" style="font-size:16px;padding:6px 20px;">⏳ Voting is closed</span>
                    <p style="margin-top:8px;color:#4a6a8a;">The election is currently closed.</p>
                `;
            } else if (appData.electionStart && new Date() < new Date(appData.electionStart)) {
                statusDiv.innerHTML = `
                    <span class="badge-not-voted" style="font-size:16px;padding:6px 20px;">⏳ Voting not started</span>
                    <p style="margin-top:8px;color:#4a6a8a;">The election will start on ${new Date(appData.electionStart).toLocaleString()}.</p>
                `;
            } else {
                statusDiv.innerHTML = `
                    <span class="badge-not-voted" style="font-size:16px;padding:6px 20px;">⏳ You have not voted yet</span>
                    <p style="margin-top:8px;color:#4a6a8a;">Cast your vote now!</p>
                    <button class="btn btn-success" onclick="openVoting()" style="margin-top:8px;max-width:200px;">🗳️ Start Voting</button>
                `;
            }

            const totalPositions = appData.positions.length;
            const completed = appData.userVotes ? Object.keys(appData.userVotes).length : 0;
            const remaining = totalPositions - completed;
            const progress = totalPositions > 0 ? Math.round((completed / totalPositions) * 100) : 0;

            document.getElementById('voterTotalPositions').textContent = totalPositions;
            document.getElementById('voterCompletedPositions').textContent = completed;
            document.getElementById('voterRemainingPositions').textContent = remaining;
            document.getElementById('voterProgressPercent').textContent = progress + '%';
            document.getElementById('voterProgressBar').style.width = progress + '%';
            document.getElementById('voterProgressText').textContent = `${completed} of ${totalPositions} positions completed`;

            const listDiv = document.getElementById('voterPositionsList');
            let listHtml = '';
            appData.positions.forEach(pos => {
                const selected = appData.userVotes && appData.userVotes[pos] ? true : false;
                const status = selected ? '✅ Completed' : '⏳ Pending';
                const color = selected ? '#1d7a3e' : '#c0392b';
                listHtml += `
                    <div style="display:flex;justify-content:space-between;padding:8px 12px;border-bottom:1px solid #eef3f9;">
                        <span><strong>${pos}</strong></span>
                        <span style="color:${color};font-weight:${selected ? 'bold' : 'normal'};">${status}</span>
                    </div>
                `;
            });
            listDiv.innerHTML = listHtml || '<p style="color:#4a6a8a;">No positions available.</p>';

            const summaryDiv = document.getElementById('voterSummaryList');
            if (appData.hasVoted) {
                let summaryHtml = '';
                appData.positions.forEach(pos => {
                    const cid = appData.userVotes[pos];
                    const candidate = appData.candidates.find(c => c.id === cid);
                    if (candidate) {
                        summaryHtml += `
                            <div class="review-item">
                                <strong>${pos}:</strong> ${candidate.name} (${candidate.platform || ''})
                            </div>
                        `;
                    }
                });
                summaryDiv.innerHTML = summaryHtml || '<p style="color:#4a6a8a;">No votes recorded.</p>';
            } else {
                summaryDiv.innerHTML = '<p style="color:#4a6a8a;">You haven\'t voted yet. Start voting to see your summary.</p>';
            }
        }

