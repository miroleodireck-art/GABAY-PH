        // ======================== COUNTDOWN TIMER ============================
        function updateCountdown() {
            const container = document.getElementById('countdownContainer');
            if (!container) return;

            const now = new Date();
            let endDate = appData.electionEnd ? new Date(appData.electionEnd) : null;
            let startDate = appData.electionStart ? new Date(appData.electionStart) : null;

            if (!endDate && !startDate) {
                container.innerHTML = '';
                return;
            }

            let html = '<div class="countdown-timer">';

            if (startDate && now < startDate) {
                const diff = startDate - now;
                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                html += `
                    <div class="timer-label">⏳ Election Starts In</div>
                    <div class="timer-display">${String(days).padStart(2,'0')}:${String(hours).padStart(2,'0')}:${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}</div>
                    <div class="status-text" style="color:var(--accent-color);">Not Started</div>
                `;
            } 
            else if (endDate && now > endDate) {
                html += `
                    <div class="timer-label">⏰ Election Ended</div>
                    <div class="status-text" style="color:#ff6b6b;">Voting is now closed</div>
                `;
            } 
            else if (endDate && now <= endDate) {
                const diff = endDate - now;
                const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((diff % (1000 * 60)) / 1000);
                html += `
                    <div class="timer-label">⏳ Time Remaining</div>
                    <div class="timer-display">${String(days).padStart(2,'0')}d ${String(hours).padStart(2,'0')}h ${String(minutes).padStart(2,'0')}m ${String(seconds).padStart(2,'0')}s</div>
                    <div class="status-text" style="color:#1d7a3e;">Voting is Open</div>
                `;
            } else {
                html += `
                    <div class="timer-label">⏳ Election Status</div>
                    <div class="status-text">${appData.electionOpen ? 'Voting is Open' : 'Voting is Closed'}</div>
                `;
            }

            html += '</div>';
            container.innerHTML = html;
        }

